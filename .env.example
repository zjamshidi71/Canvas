# Supabase credentials â€” get these from your Supabase project's Settings > API page
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role / secret key â€” SERVER ONLY, never add NEXT_PUBLIC_
# Used by the Stripe webhook to mark orders as paid (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe (test mode) â€” Stripe Dashboard > Developers > API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here
STRIPE_SECRET_KEY=sk_test_your-key-here
# From `stripe listen` (local) or Dashboard > Developers > Webhooks (deployed)
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here

# Resend (order confirmation emails) â€” resend.com > API Keys
RESEND_API_KEY=re_your-key-here
# Optional. Defaults to "Canvas <onboarding@resend.dev>" until you verify a domain
EMAIL_FROM=Canvas <orders@yourdomain.com>

# OpenRouter (AI features) — openrouter.ai > Keys. SERVER ONLY.
OPENROUTER_API_KEY=sk-or-your-key-here
# Optional. Any vision-capable model ID from openrouter.ai/models
AI_MODEL=google/gemini-2.5-flash
